# NO WAY BARBERSHOP — environment variables
# Copy to .env.local for local work, and set the same keys in the Vercel
# project (Settings → Environment Variables) for production.
#
# NEVER commit real values. This file holds placeholders only.
# All of these are read SERVER-SIDE ONLY, inside api/style-ticket.js.
# Nothing here is ever exposed to the browser.

# ---------------------------------------------------------------------------
# TRANSACTIONAL EMAIL (Resend — https://resend.com)
# ---------------------------------------------------------------------------
# Without RESEND_API_KEY the style-ticket endpoint runs in DEV FALLBACK mode:
# it validates the request and logs the ticket to the server console, and it
# tells the customer plainly that the shop was not notified. It does NOT
# pretend the email was sent. Production is not ready until this is set.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where Jose receives cut requests. Comma-separate for multiple recipients.
NOTIFY_EMAIL=jose@example.com

# Verified sender. The domain must be verified in Resend or delivery fails.
# Use a subdomain you control, e.g. tickets@mail.nowaybarbershop.com
NOTIFY_FROM="No Way Barbershop <tickets@nowaybarbershop.com>"

# Optional: copy the shop's second inbox on every ticket.
# NOTIFY_BCC=

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------
# Public site origin. Used to build absolute links inside the email to Jose.
# Defaults to https://nowaybarbershop.com when unset.
SITE_ORIGIN=https://nowaybarbershop.com

# Max style tickets accepted per IP per hour by a single serverless instance.
# Best-effort only — see the note in api/style-ticket.js. Defaults to 5.
RATE_LIMIT_PER_HOUR=5
