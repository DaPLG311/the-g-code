{
  "redirects": [
    { "source": "/launch.html", "destination": "/how-it-works.html", "permanent": true },
    { "source": "/services.html", "destination": "/what-we-build.html", "permanent": true },
    { "source": "/live.html", "destination": "/", "permanent": true },
    { "source": "/vault.html", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'sha256-oBkAtP2yUjfITLf1M8bTc6RYK0fkNwTk8qH+EGXBMi0='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; base-uri 'self'; frame-ancestors 'self'; form-action 'self' mailto:; object-src 'none'; upgrade-insecure-requests" }
      ]
    }
  ]
}
